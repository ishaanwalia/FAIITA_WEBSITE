// FAIITA — Prisma Schema
// Production datasource: Neon Postgres.
// url = pooled connection (has "-pooler" in the hostname) — used at runtime.
// directUrl = direct, non-pooled connection — used for migrations only.
// Both come from environment variables — see .env / Vercel env vars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One row per Indian state/UT covered by FAIITA — powers the interactive map,
/// /about/state-associations, and the /about/state-associations/[slug] pages.
model StateAssociation {
  id                 String              @id @default(cuid())
  slug               String              @unique
  stateName          String
  stateCode          String // e.g. "MH", "DL" — matches map region ids
  region             String // North | South | East | West | Central (NECTA/North-East sits under East)
  associationName    String
  foundedYear        Int?
  memberCount        Int                 @default(0)
  presidentName      String?
  secretaryName      String?
  contactEmail       String?
  secretaryEmail     String?
  contactPhone       String?
  websiteUrl         String?
  address            String?
  description        String?
  logoUrl            String?
  mapX               Float // relative x position (0-100) on the illustrated map
  mapY               Float // relative y position (0-100) on the illustrated map
  isCovered          Boolean             @default(true)
  memberAssociations MemberAssociation[]
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([region])
  @@index([deletedAt])
}

/// Individual member associations that belong to a state chapter.
model MemberAssociation {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  city           String?
  type           String // Retail | Distribution | Services | Solutions | Manufacturing
  memberCount    Int              @default(0)
  foundedYear    Int?
  description    String?
  logoUrl        String?
  website        String?
  presidentName  String?
  contactEmail   String?
  contactPhone   String?
  secretaryPhone String?
  isDemo         Boolean          @default(false)
  stateId        String
  state          StateAssociation @relation(fields: [stateId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  @@index([stateId])
  @@index([deletedAt])
}

/// National leadership — Governing Body / office bearers.
model Leader {
  id              String    @id @default(cuid())
  name            String
  role            String // President, Sr. Vice President, Secretary General, etc.
  order           Int       @default(0)
  bio             String?
  imageUrl        String?
  associationName String?
  stateName       String?
  email           String?
  phone           String?
  linkedIn        String?
  category        String    @default("national") // national | state
  term            String    @default("2024–2026") // e.g. "2024–2026", FAIITA GB terms run 2 years
  isCurrent       Boolean   @default(true)
  focusAreas      String? // comma-separated tags, shown only on the spotlight/featured card
  /// The digital-visiting-card fields, migrated in from lib/leader-profiles.ts.
  /// journey and companies are JSON because they are ordered lists of small
  /// objects ({ text, url } / { name, url }) that are only ever read and
  /// written whole — a join table would buy nothing and cost two more screens.
  journey         Json?
  companies       Json?
  location        String?
  website         String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([category, order])
  @@index([deletedAt])
}

model News {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  category    String // Events | Policy | Initiative | Press Release
  coverImage  String? // card/featured background image
  heroImage   String? // large image shown at the top of the article page
  sourceUrl   String? // link to original coverage (press, magazine)
  featured    Boolean   @default(false)
  isDemo      Boolean   @default(false) // placeholder content, remove when real content lands
  /// Optional deep link to the state association page a story is most about.
  /// Two plain columns rather than a relation: the label is editorial ("in
  /// Rajasthan", "in the North East") and doesn't always match the state's own
  /// name, and a story can point at a state row that later gets renamed
  /// without the link needing to change.
  relatedStateSlug  String?
  relatedStateLabel String?
  publishedAt DateTime  @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([publishedAt])
  @@index([deletedAt])
}

model Event {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  description      String
  category         String // AGM | Summit | Workshop | Conference
  startDate        DateTime
  endDate          DateTime?
  city             String
  state            String
  venue            String?
  coverImage       String?
  registrationLink String?
  isUpcoming       Boolean   @default(true)
  isDemo           Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([startDate])
  @@index([deletedAt])
}

model GalleryItem {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  category  String // Events | Summits | Leadership | Regional Meets
  caption   String?
  order     Int       @default(0)
  isDemo    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([category])
  @@index([deletedAt])
}

/// A gallery album — one event, one set of photographs. Migrated in from
/// lib/gallery-albums.ts. Photos are a real relation rather than JSON because
/// the CMS reorders, captions and deletes them individually, which is exactly
/// the case where a join table earns its keep.
model GalleryAlbum {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  eyebrow     String
  description String
  order       Int            @default(0)
  photos      GalleryPhoto[]
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([order])
  @@index([deletedAt])
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  src       String
  caption   String
  order     Int          @default(0)
  deletedAt DateTime?

  @@unique([albumId, src])
  @@index([albumId, order])
  @@index([deletedAt])
}

model Newsletter {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  fileUrl     String? // Heyzine flip-book URL or /newsletters/<file>.pdf under /public
  issueNumber Int
  issueDate   DateTime
  isDemo      Boolean   @default(false)
  deletedAt   DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([issueDate])
  @@index([deletedAt])
}

model Policy {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // Annual | Research | Policy | White Paper
  fileUrl     String?
  fileSize    String? // e.g. "4.2 MB"
  isDemo      Boolean  @default(false)
  publishedAt DateTime @default(now())

  @@index([category])
}

model Testimonial {
  id          String    @id @default(cuid())
  deletedAt   DateTime?
  name        String
  role        String
  association String
  quote       String
  imageUrl    String?
  order       Int       @default(0)

  @@index([order])
}

model Stat {
  id     String  @id @default(cuid())
  label  String
  value  String // stored as string to allow "29", "100+", "5L+"
  suffix String?
  icon   String? // lucide icon name
  order  Int     @default(0)

  @@index([order])
}

model ContactSubmission {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  subject      String?
  message      String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt])
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  subscribedAt DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt])
}

/// CMS administrator. Three rows only (president, secretary, ishaan) — this is
/// not a public sign-up surface, so there is no registration flow and no role
/// column yet: every admin can do everything. Add roles when the first person
/// needs less than full access, not before.
model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// scrypt, stored as "salt:hash" in hex. See lib/auth.ts.
  passwordHash       String
  /// Set on the accounts created by scripts/create-admins.ts, whose passwords
  /// were generated and shown once. Cleared the first time they choose their
  /// own. Login succeeds but every admin page redirects to /admin/password
  /// until it is false.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  /// Login throttling. Reset to 0 on a successful login. See lib/auth.ts.
  failedLoginAttempts Int      @default(0)
  /// Set once failedLoginAttempts crosses the threshold; login is refused
  /// until this passes, regardless of password correctness.
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Every write the CMS makes: who, when, and what changed field by field.
/// Append-only — nothing in the dashboard updates or deletes a row here.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String // create | update | delete | restore
  model       String // News, Event, GalleryAlbum, ...
  recordId    String
  /// Human-readable name of the record at the time of the change, so the log
  /// still reads sensibly after the record is renamed or hard-deleted.
  recordLabel String
  /// { field: { from, to } } for updates; null for create and delete.
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([model, recordId])
}
